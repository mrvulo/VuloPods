<Window x:Class="VuloPods.App.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VuloPods.App"
        Title="VuloPods"
        Width="300" Height="150"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="Bar" TargetType="ProgressBar">
            <Setter Property="Height" Value="8" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Foreground" Value="#4CD964" />
            <Setter Property="Background" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#BBBBBB" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Bolt" TargetType="TextBlock">
            <Setter Property="Text" Value="⚡" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <Border Background="#EE1E1E22" CornerRadius="12" Padding="16" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.5" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{Binding ModelName}" Foreground="White" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="4">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource Label}" Text="Links" />
                        <TextBlock Style="{StaticResource Label}" Text=" ●" Foreground="#4CD964" Visibility="{Binding LeftInEar, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource Value}" Text="{Binding LeftText}" />
                        <TextBlock Style="{StaticResource Bolt}" Visibility="{Binding LeftCharging, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <ProgressBar Style="{StaticResource Bar}" Value="{Binding LeftPercent, Mode=OneWay}" Margin="0,6,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="4">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource Label}" Text="Rechts" />
                        <TextBlock Style="{StaticResource Label}" Text=" ●" Foreground="#4CD964" Visibility="{Binding RightInEar, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource Value}" Text="{Binding RightText}" />
                        <TextBlock Style="{StaticResource Bolt}" Visibility="{Binding RightCharging, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <ProgressBar Style="{StaticResource Bar}" Value="{Binding RightPercent, Mode=OneWay}" Margin="0,6,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="4">
                    <TextBlock Style="{StaticResource Label}" Text="Case" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource Value}" Text="{Binding CaseText}" />
                        <TextBlock Style="{StaticResource Bolt}" Visibility="{Binding CaseCharging, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <ProgressBar Style="{StaticResource Bar}" Value="{Binding CasePercent, Mode=OneWay}" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
